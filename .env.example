# Both of these are safe to publish. The anon key is designed to be public;
# row level security is what actually protects the data. The service role key
# must never appear in this app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Where the session cookie is scoped, so Run Sheet and this app share a login.
# Leave blank in local dev to fall back to localStorage.
VITE_SESSION_COOKIE_DOMAIN=
